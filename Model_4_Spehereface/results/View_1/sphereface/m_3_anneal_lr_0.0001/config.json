  "loss": {
    "name": "A-Softmax (Liu et al., 2017)",
    "classifier": "normalized weights ||w_j|| = 1, zero bias, logits = ||x|| cos(theta_j)",
    "margin_m": 3,
    "psi": "(-1)^k cos(m theta) - 2k, k = floor(m theta / pi); cos(m theta) by Chebyshev polynomial",
    "target_logit": "||x|| (lambda cos(theta_y) + psi(theta_y)) / (1 + lambda)",
    "annealing": true,
    "annealing_schedule": "lambda = max(5.0, 1000.0 * (1 + 0.12 * iteration) ^ -1.0), updated every batch",
    "numerical_stability": "cos clamped to [-1+1e-7, 1-1e-7] before acos"
  },
  "optimizer": {
