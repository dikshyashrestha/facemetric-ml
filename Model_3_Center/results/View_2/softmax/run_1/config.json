    "T_max_epochs": 30,
    "eta_min": 0.0,
    "step": "once per epoch"
  },
  "batch_size": 64,
  "batches_per_epoch": 113,
  "max_epochs": 30,
  "sampling": "uniform shuffle of all training images each epoch, last partial batch dropped",
  "training_data": {
    "classes": 1336,
    "training_images": 7240,
    "min_images_per_class": 2,
    "evaluation_identity_overlap": 0
